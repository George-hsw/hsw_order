# Copy to .env.local for local development. Vercel takes the same names under Project, Settings, Environment Variables.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Adobe Fonts web project id (the part before .css in https://use.typekit.net/<id>.css). Turns on Myriad Pro.
VITE_ADOBE_FONTS_KIT=
# The service_role key and the DYN_* secrets belong only in GitHub Actions secrets. Never put them in a VITE_ variable or in this file.
