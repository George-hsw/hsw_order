# Local test of the NAV sync. Copy this file to .env.sync in the project folder (it is git-ignored), fill in the values there,
# and run:
#   node --env-file=.env.sync scripts/sync-dynamics.mjs --discover
# --discover only reads three rows from each service and prints the field names. It writes nothing anywhere.
# Never put real values in THIS file: it is committed to git.

# Retail Items and Replen. Qty. web services (OData URLs), for example
#   https://nav.example.com:7048/PROD/ODataV4/Company('Company%20Name')/Service_Name
DYN_ITEMS_URL=
DYN_STOCK_URL=

# NAV web service access: user name and access key...
DYN_USER=
DYN_ACCESS_KEY=
# ...or Business Central online with an Entra app (leave the two above empty)
DYN_TENANT_ID=
DYN_CLIENT_ID=
DYN_CLIENT_SECRET=

# Not needed for --discover. Only for a real sync run.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
